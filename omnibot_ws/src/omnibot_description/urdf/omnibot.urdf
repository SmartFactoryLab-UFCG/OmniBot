<?xml version="1.0"?>
<robot name="simple_robot">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://omnibot_description/meshes/3w_v2/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.09" radius="0.125"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.9" ixy="0.0" ixz="0.0" iyy="0.9" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="omni_wheel_link_1">
    <visual>
      <geometry>
        <mesh filename="package://omnibot_description/meshes/3w_v2/omni_frame.stl"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://omnibot_description/meshes/3w_v2/omni_frame.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="omni_wheel_joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="omni_wheel_link_1"/>
    <origin rpy="-0.8040 1.5708 -0.8040" xyz="0.0927 0.0000 0.0145"/>
    <axis xyz="0 0 -1"/>
  </joint>
  
