    def OmniGraph "ActionGraph_Scan"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "isaac_read_lidar_beams_node" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ActionGraph_Scan/on_playback_tick.outputs:tick>
            custom rel inputs:lidarPrim = </World/turtlebot3_waffle2/base_footprint/base_link/base_scan/Lidar> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.sensors.physx.IsaacReadLidarBeams"
            int node:typeVersion = 1
            custom float2 outputs:azimuthRange
            custom float[] outputs:beamTimeData
            custom float2 outputs:depthRange
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom float outputs:horizontalFov
            custom float outputs:horizontalResolution
            custom uchar[] outputs:intensitiesData
            custom float[] outputs:linearDepthData
            custom int outputs:numCols
            custom int outputs:numRows
            custom float outputs:rotationRate
            custom float outputs:verticalFov
            custom float outputs:verticalResolution
            custom float2 outputs:zenithRange
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (582.4495, 125.760445)
        }

        def OmniGraphNode "ros2_publish_laser_scan" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom float2 inputs:azimuthRange
            prepend float2 inputs:azimuthRange.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:azimuthRange>
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ActionGraph_Scan/ros2_context.outputs:context>
            custom float2 inputs:depthRange
            prepend float2 inputs:depthRange.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:depthRange>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:execOut>
            custom string inputs:frameId = "base_scan"
            custom float inputs:horizontalFov
            prepend float inputs:horizontalFov.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:horizontalFov>
            custom float inputs:horizontalResolution
            prepend float inputs:horizontalResolution.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:horizontalResolution>
            custom uchar[] inputs:intensitiesData
            prepend uchar[] inputs:intensitiesData.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:intensitiesData>
            custom float[] inputs:linearDepthData
            prepend float[] inputs:linearDepthData.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:linearDepthData>
            custom string inputs:nodeNamespace
            custom int inputs:numCols
            prepend int inputs:numCols.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:numCols>
            custom int inputs:numRows
            prepend int inputs:numRows.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:numRows>
            custom string inputs:qosProfile
            prepend string inputs:qosProfile.connect = </World/ActionGraph_Scan/ros2_qos_profile.outputs:qosProfile>
            custom uint64 inputs:queueSize
            custom float inputs:rotationRate
            prepend float inputs:rotationRate.connect = </World/ActionGraph_Scan/isaac_read_lidar_beams_node.outputs:rotationRate>
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </World/ActionGraph_Scan/isaac_read_simulation_time.outputs:simulationTime>
            custom string inputs:topicName
            token node:type = "isaacsim.ros2.bridge.ROS2PublishLaserScan"
            int node:typeVersion = 2
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (906.74725, 116.71354)
        }

        def OmniGraphNode "on_playback_tick" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (84.86836, 106.97067)
        }

        def OmniGraphNode "ros2_context" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uchar inputs:domain_id = 10
            custom bool inputs:useDomainIDEnvVar
            token node:type = "isaacsim.ros2.bridge.ROS2Context"
            int node:typeVersion = 2
            custom uint64 outputs:context
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (86.9561, 273.29504)
        }

        def OmniGraphNode "isaac_read_simulation_time" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint64 inputs:referenceTimeDenominator
            custom int64 inputs:referenceTimeNumerator
            custom bool inputs:resetOnStop
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (84.868355, 421.52548)
        }

        def OmniGraphNode "ros2_qos_profile" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:createProfile (
                allowedTokens = ["Default for publishers/subscribers", "Services", "Sensor Data", "System Default", "Custom"]
            )
            custom double inputs:deadline
            custom uint64 inputs:depth
            custom token inputs:durability (
                allowedTokens = ["systemDefault", "transientLocal", "volatile", "unknown"]
            )
            custom token inputs:history (
                allowedTokens = ["systemDefault", "keepLast", "keepAll", "unknown"]
            )
            custom double inputs:leaseDuration
            custom double inputs:lifespan
            custom token inputs:liveliness (
                allowedTokens = ["systemDefault", "automatic", "manualByTopic", "unknown"]
            )
            custom token inputs:reliability (
                allowedTokens = ["systemDefault", "reliable", "bestEffort", "unknown"]
            )
            token node:type = "isaacsim.ros2.bridge.ROS2QoSProfile"
            int node:typeVersion = 1
            custom string outputs:qosProfile
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-185.8436, 214.83766)
        }
    }

    def Xform "Environment"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def DistantLight "defaultLight" (
            prepend apiSchemas = ["ShapingAPI"]
