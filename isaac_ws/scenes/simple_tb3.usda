def Xform "World"
{
    def "turtlebot3_waffle2" (
        prepend references = @../../ros2_ws/src/turtlebot3/turtlebot3_description/urdf/turtlebot3_waffle2/turtlebot3_waffle2.usd@
    )
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 1.2392515720106843, -0.7701134689877622)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "base_footprint"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )

            over "base_link"
            {
                over "base_scan"
                {
                    def Lidar "Lidar"
                    {
                        bool drawLines = 1
                        bool drawPoints = 0
                        bool enabled = 1
                        bool enableSemantics = 0
                        bool highLod = 0
                        float horizontalFov = 360
                        float horizontalResolution = 0.4
                        float maxRange = 100
                        float minRange = 0.4
                        float rotationRate = 20
                        float verticalFov = 30
                        float verticalResolution = 4
                        double3 xformOp:rotateXYZ = (0, 0, -180)
                        double3 xformOp:translate
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                        float yawOffset = 0
                    }
                }
            }
        }

        over "wheel_left_link"
        {
        }

        over "wheel_right_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )
        }
    }

