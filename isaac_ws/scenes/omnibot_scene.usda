    def Scope "Looks"
    {
        token visibility = "invisible"

        def Material "AprilTag"
        {
            token outputs:mdl:displacement.connect = </World/Looks/AprilTag/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/AprilTag/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/AprilTag/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/4.5/Isaac/Materials/AprilTag/AprilTag.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AprilTag"
                custom asset inputs:tag_mosaic = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/4.5/Isaac/Materials/AprilTag/Textures/tag36h11.png@
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "OmniPBR"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.042763874, 0.37714404, 0.6643678)
                color3f inputs:diffuse_tint = (0.31518036, 0.3996353, 0.6528736)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "OmniPBR_01"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR_01/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR_01/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR_01/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (1.11, 0.97930956, 0)
                color3f inputs:diffuse_tint = (1.205862, 1.23, 1.09)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "black"
        {
            token outputs:mdl:displacement.connect = </World/Looks/black/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/black/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/black/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.000001, 9.9999e-7, 9.9999e-7)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def "Materiais"
        {
            def Material "physics_material" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.5
                float physics:restitution = 0.8
                float physics:staticFriction = 0.5
            }

            def Material "Floor_Material"
            {
                token outputs:mdl:surface.connect = </World/Looks/Materiais/Floor_Material/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float3 inputs:diffuseColor = (0.96, 0.96, 0.94)
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "Wall_1_Material"
            {
                token outputs:mdl:surface.connect = </World/Looks/Materiais/Wall_1_Material/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float3 inputs:diffuseColor = (0.88, 0.88, 0.88)
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }
        }
    }

    def Xform "ConveyorBelt_A09" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/4.5/Isaac/Props/Conveyors/ConveyorBelt_A09.usd@
    )
    {
        token visibility = "inherited"
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.6, 0.65, 0.8)
        double3 xformOp:translate = (1.317652950723247, -0.9803181833644101, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        over "SM_ConveyorBelt_A09_02" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/ConveyorBelt_A09/Looks/Metal_Rough_A> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        over "Belt"
        {
            over "SM_ConveyorBelt_A09_Belt_02" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/ConveyorBelt_A09/Looks/Plastic_Red_A> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }

        over "Looks"
        {
            over "Plastic_Red_A"
            {
